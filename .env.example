# TANIM local environment
# Copy this file to .env and fill in local values.
# Never commit .env.

APP_ENV=development

# PostgreSQL
DATABASE_URL=

# Local service addresses
LANDING_URL=http://127.0.0.1:3000
AUTH_URL=http://127.0.0.1:3001
PLATFORM_URL=http://127.0.0.1:3002
DOCS_URL=http://127.0.0.1:3003
API_URL=http://127.0.0.1:8000

# Authentication
# Keep these values empty in the committed example. The local seed command
# stops if either development password is missing.
TANIM_DEMO_FARMER_PASSWORD=
TANIM_DEMO_COOP_PASSWORD=
TANIM_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003
TANIM_SESSION_COOKIE_SECURE=false
